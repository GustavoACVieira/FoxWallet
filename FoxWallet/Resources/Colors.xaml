<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CorFundoPrincipal" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush  StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="CorPrimaria" Color="#191919" Offset="1"/>
                    <GradientStop x:Name="CorSecundaria" Color="#FF292626" Offset="0.5"/>
                    <GradientStop x:Name="CorTerciaria" Color="#FF403838" Offset="0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="CorTelaAddBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop x:Name="CorPrimaria" Color="#FF2F2C2C" Offset="0"/>
        <GradientStop x:Name="CorSecundaria" Color="#FF3A3535" Offset="1"/>
        <GradientStop x:Name="CorTerciaria" Color="#FF5B5858" Offset="0.5"/>
    </LinearGradientBrush>
</ResourceDictionary>