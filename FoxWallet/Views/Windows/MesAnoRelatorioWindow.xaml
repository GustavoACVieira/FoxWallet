<Window x:Class="FoxWallet.Views.Windows.MesAnoRelatorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoxWallet.Views.Windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="MesAnoRelatorioWindow" Height="200" Width="250">

    <Border CornerRadius="20"
            Background="{StaticResource CorTelaAddBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--#region R1-->
            <TextBlock Grid.Row="0" 
                       Text="Mês:"
                       Foreground="White"
                       FontSize="15"
                       Margin="20,5,0,0"/>

            <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                      ItemsSource="{Binding Meses}"
                      SelectedItem="{Binding MesSelecionado}"
                      Style="{StaticResource ComboBoxGerarRelatorio}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!--#endregion-->
            
            <!--#region R2-->
            <TextBlock Grid.Row="1" 
                       Text="Ano:"
                       Foreground="White"
                       FontSize="15"
                       Margin="20,5,0,0"/>

            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding Ano, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxGerarRelatorio}"
                     MaxLength="4"/>
            <!--#endregion-->

            <!--#region R3-->
            <Button Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource BotaoCancelar}"
                    Content="Cancelar" 
                    HorizontalAlignment="Center"
                    Command="{Binding FecharJanelaCommand}"/>

            <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource BotaoCancelar}"
                    Content="Gerar"
                    HorizontalAlignment="Center"
                    Command="{Binding GerarRelatorioCommand}"/>
            <!--#endregion-->
        </Grid>
    </Border>
</Window>
