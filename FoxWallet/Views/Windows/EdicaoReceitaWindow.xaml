<Window x:Class="FoxWallet.Views.Windows.EdicaoReceitaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoxWallet.Views.Windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="EdicaoReceitaWindow" Height="290" Width="500">

    <Border CornerRadius="30"
            Background="{StaticResource CorTelaAddBrush}"
            BorderThickness="2"
            BorderBrush="#3F3F3F">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!--#region Top-->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Editar Receita"
                   Foreground="White"
                   FontSize="18"
                   Margin="20,15,0,0"/>

        <Button Grid.Row="0" Grid.Column="1"
                Margin="0,0,10,10"
                Content="X"
                Style="{StaticResource BotaoX}"
                Command="{Binding FecharJanelaEditarReceitaCommand}"/>
        <!--#endregion-->

        <!--#region R1-->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Tipo de Receita"
                   Margin="15,5,0,0"
                   Foreground="#FFC1C1C1"/>

        <ComboBox Grid.Row="1" Grid.Column="0"
                  Style="{StaticResource ComboBoxAddReceitaDepesa}"
                  ItemsSource="{Binding ETR}"
                  SelectedItem="{Binding ETipoRec}"/>

        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="Observações"
                   Margin="15,5,0,0"
                   Foreground="#FFC1C1C1"/>

        <TextBox Grid.Row="1" Grid.Column="1"
                 Style="{StaticResource TextBoxAddReceitaDespesa}"
                 Text="{Binding EObs, UpdateSourceTrigger=PropertyChanged}"/>
        <!--#endregion-->

        <!--#region R2-->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Data"
                   Margin="15,5,0,0"
                   Foreground="#FFC1C1C1"/>

        <DatePicker Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource DatePickerAddReceitaDepesa}"
                    SelectedDate="{Binding EDataRec}"/>

        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="Preço em R$"
                   Margin="15,5,0,0"
                   Foreground="#FFC1C1C1"/>

        <TextBox Grid.Row="2" Grid.Column="1"
                 Style="{StaticResource TextBoxAddReceitaDespesa}"
                 Text="{Binding EValor, StringFormat=c, ConverterCulture=pt-BR, UpdateSourceTrigger=PropertyChanged}"/>
        <!--#endregion-->

        <!--#region Bottom-->
        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource BotaoCancelar}"
                Content="Cancelar"
                HorizontalAlignment="Center"
                Command="{Binding FecharJanelaEditarReceitaCommand}"/>

        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource BotaoAdicionar}"
                Content="Salvar"
                HorizontalAlignment="Center"
                Command="{Binding EditarReceitaCommand}"/>
        <!--#endregion-->
    </Grid>
    </Border>
</Window>
